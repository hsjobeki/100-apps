<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Checkout · Mill &amp; Thread</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;450;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#faf8f4; --surface:#ffffff; --ink:#201f1c; --ink-2:#5b5750; --ink-3:#8a847a;
    --line:#e4ded3; --line-2:#d3cbbd;
    --accent:#14654f; --accent-ink:#0d4436; --accent-soft:#e6f1ed;
    --danger:#b42318; --danger-soft:#fdeceb; --warn:#b54708; --warn-soft:#fdf3e8;
    --r:10px; --r-lg:16px;
    --shadow:0 1px 2px rgba(32,31,28,.06), 0 8px 24px -14px rgba(32,31,28,.22);
  }
  *{box-sizing:border-box}
  html,body{margin:0}
  body{
    background:var(--paper); color:var(--ink);
    font:450 15px/1.5 Inter, system-ui, -apple-system, Segoe UI, sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{margin:0}
  button{font:inherit;color:inherit}
  .money{font-variant-numeric:tabular-nums}

  /* ---------- shell ---------- */
  .topbar{
    border-bottom:1px solid var(--line); background:#fffdf9;
    padding:14px 24px; display:flex; align-items:center; gap:12px;
  }
  .brand{display:flex;align-items:center;gap:9px;font-family:Fraunces,Georgia,serif;font-weight:600;font-size:19px;letter-spacing:-.01em}
  .brand svg{display:block}
  .secure{
    margin-left:auto; display:flex; align-items:center; gap:6px;
    color:var(--accent-ink); background:var(--accent-soft); border:1px solid #cfe3dc;
    padding:5px 10px; border-radius:999px; font-size:12.5px; font-weight:500;
  }
  .wrap{max-width:1080px;margin:0 auto;padding:28px 24px 64px;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.95fr);gap:32px;align-items:start}
  @media (max-width:900px){
    .wrap{grid-template-columns:minmax(0,1fr);gap:20px;padding:18px 16px 48px}
    .col-form{order:2} .col-sum{order:1}
  }

  /* ---------- form ---------- */
  .head{display:flex;align-items:flex-end;gap:12px;margin-bottom:18px;flex-wrap:wrap}
  .head h1{font-family:Fraunces,Georgia,serif;font-size:27px;font-weight:600;letter-spacing:-.02em}
  .ghost{
    margin-left:auto;background:transparent;border:1px solid var(--line-2);border-radius:999px;
    padding:6px 12px;font-size:12.5px;font-weight:500;color:var(--ink-2);cursor:pointer;
    display:flex;align-items:center;gap:6px;
  }
  .ghost:hover:not(:disabled){background:#fff;border-color:var(--ink-3);color:var(--ink)}
  .ghost:disabled{opacity:.45;cursor:not-allowed}

  .card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);box-shadow:var(--shadow)}
  section.step{padding:18px 20px 20px;border-bottom:1px solid var(--line)}
  .step-head{display:flex;align-items:center;gap:10px;margin-bottom:14px}
  .step-head h2{font-size:15.5px;font-weight:600;letter-spacing:-.01em}
  .dot{
    width:24px;height:24px;flex:0 0 24px;border-radius:50%;
    border:1.5px solid var(--line-2);color:var(--ink-3);background:#fff;
    display:grid;place-items:center;font-size:12px;font-weight:600;transition:.18s
  }
  .dot.done{background:var(--accent);border-color:var(--accent);color:#fff}
  .dot.bad{background:var(--danger);border-color:var(--danger);color:#fff}
  .who{
    margin-left:auto;display:flex;align-items:center;gap:7px;font-size:12.5px;color:var(--ink-2);
    background:var(--paper);border:1px solid var(--line);border-radius:999px;padding:3px 10px 3px 4px;
  }
  .who .av{width:22px;height:22px;border-radius:50%;background:var(--accent);color:#fff;display:grid;place-items:center;font-size:10.5px;font-weight:600;letter-spacing:.02em}
  .who.skel{color:transparent;background:linear-gradient(90deg,#f1ece3,#f8f5ef,#f1ece3);background-size:200% 100%;animation:sheen 1.2s linear infinite;border-color:transparent}
  .who.skel .av{background:#e4ded3}
  @keyframes sheen{to{background-position:-200% 0}}

  .grid{display:grid;gap:14px 12px;grid-template-columns:repeat(6,1fr)}
  .f{display:flex;flex-direction:column;gap:6px;min-width:0}
  .c6{grid-column:span 6}.c3{grid-column:span 3}
  @media (max-width:520px){.c3{grid-column:span 6}}
  label{font-size:12.5px;font-weight:500;color:var(--ink-2)}
  .inwrap{position:relative;display:flex;align-items:center}
  input,select{
    width:100%;height:44px;padding:0 12px;border:1px solid var(--line-2);border-radius:var(--r);
    background:#fff;color:var(--ink);font:450 15px/1 Inter,system-ui,sans-serif;
  }
  input::placeholder{color:#b3ac9f}
  select{appearance:none;padding-right:34px;cursor:pointer}
  input:disabled,select:disabled{background:#f7f4ef;color:var(--ink-3);cursor:not-allowed}
  .chev{position:absolute;right:11px;pointer-events:none;color:var(--ink-3)}
  input:focus-visible,select:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .brandmark{position:absolute;right:10px;display:flex;align-items:center;pointer-events:none}
  input.pad-r{padding-right:56px}
  [aria-invalid="true"]{border-color:var(--danger);background:#fffbfb}
  .msg{display:none;align-items:center;gap:6px;font-size:12.5px;color:var(--danger);font-weight:500;margin:0}
  .msg.on{display:flex}
  .msg svg{flex:0 0 14px}
  .hint{font-size:12px;color:var(--ink-3);margin:0}

  /* ---------- pay bar ---------- */
  .pay{padding:18px 20px 20px}
  .payrow{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
  .btn{
    flex:1 1 220px;min-height:50px;border:0;border-radius:var(--r);cursor:pointer;
    background:var(--accent);color:#fff;font-size:15.5px;font-weight:600;letter-spacing:-.01em;
    display:flex;align-items:center;justify-content:center;gap:9px;transition:.15s;
  }
  .btn:hover:not(:disabled){background:var(--accent-ink)}
  .btn:disabled{cursor:not-allowed;background:#9fb8b0}
  .btn.busy{background:var(--accent-ink);cursor:progress}
  .btn-sub{
    background:#fff;border:1px solid var(--line-2);color:var(--ink);border-radius:var(--r);
    min-height:50px;padding:0 18px;font-weight:500;cursor:pointer;flex:0 0 auto
  }
  .btn-sub:hover{border-color:var(--ink-3)}
  .spin{width:17px;height:17px;flex:0 0 17px;animation:sp .8s linear infinite}
  @keyframes sp{to{transform:rotate(360deg)}}
  .clock{display:flex;align-items:center;gap:10px;font-size:12.5px;color:var(--ink-2);margin-top:12px}
  .track{height:4px;border-radius:99px;background:var(--line);overflow:hidden;position:relative;flex:1 1 auto;min-width:80px}
  .track i{position:absolute;top:0;bottom:0;width:38%;border-radius:99px;background:var(--accent);animation:slide 1.15s ease-in-out infinite}
  @keyframes slide{0%{left:-40%}100%{left:100%}}
  .foot{margin:12px 0 0;font-size:12px;color:var(--ink-3);display:flex;align-items:center;gap:6px}

  /* ---------- banners ---------- */
  .banner{display:none;gap:11px;padding:12px 14px;border-radius:var(--r);margin-bottom:12px;font-size:13.5px;line-height:1.45}
  .banner.on{display:flex}
  .banner > svg{flex:0 0 18px;margin-top:1px}
  .banner b{font-weight:600;display:block;margin-bottom:2px}
  .banner.err{background:var(--danger-soft);border:1px solid #f4c9c5;color:#7a1710}
  .banner.warn{background:var(--warn-soft);border:1px solid #f3ddbf;color:#7a3708}
  .banner .acts{display:flex;gap:8px;margin-top:9px;flex-wrap:wrap}
  .banner .acts button{
    background:#fff;border:1px solid currentColor;border-radius:8px;padding:5px 11px;
    font-size:12.5px;font-weight:600;cursor:pointer
  }
  .banner .acts button.jump{font-weight:500}

  /* ---------- summary ---------- */
  .col-sum{position:sticky;top:20px}
  @media (max-width:900px){.col-sum{position:static}}
  .sum{padding:18px 18px 10px}
  .sum h2{font-size:12.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3);margin-bottom:14px}
  .line{display:flex;gap:12px;padding:12px 0;border-top:1px solid var(--line)}
  .line:first-child{border-top:0;padding-top:0}
  .thumb{width:54px;height:54px;flex:0 0 54px;border-radius:9px;border:1px solid var(--line);overflow:hidden}
  .thumb svg{display:block;width:100%;height:100%}
  .lmid{flex:1 1 auto;min-width:0}
  .lname{font-size:13.5px;font-weight:500;line-height:1.35}
  .lmeta{font-size:12px;color:var(--ink-3);margin-top:2px}
  .qty{display:inline-flex;align-items:center;margin-top:7px;border:1px solid var(--line-2);border-radius:8px;overflow:hidden;background:#fff}
  .qty button{width:26px;height:26px;border:0;background:transparent;cursor:pointer;color:var(--ink-2);display:grid;place-items:center;padding:0}
  .qty button:hover:not(:disabled){background:var(--paper);color:var(--ink)}
  .qty button:disabled{color:#ccc5b8;cursor:not-allowed}
  .qty span{min-width:26px;text-align:center;font-size:13px;font-weight:600;font-variant-numeric:tabular-nums}
  .lright{display:flex;flex-direction:column;align-items:flex-end;gap:6px}
  .lprice{font-size:13.5px;font-weight:500}
  .rm{border:0;background:transparent;cursor:pointer;color:var(--ink-3);padding:3px;border-radius:6px;display:grid;place-items:center}
  .rm:hover:not(:disabled){color:var(--danger);background:var(--danger-soft)}
  .rm:disabled{color:#d8d2c7;cursor:not-allowed}
  .ship{padding:14px 0;border-top:1px solid var(--line)}
  .shiprow{display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--ink-2);margin-bottom:7px}
  .bar{height:6px;border-radius:99px;background:var(--line);overflow:hidden}
  .bar i{display:block;height:100%;border-radius:99px;background:var(--accent);transition:width .3s ease}
  .totals{border-top:1px solid var(--line);padding:14px 0 6px;display:grid;gap:8px}
  .trow{display:flex;justify-content:space-between;font-size:13.5px;color:var(--ink-2)}
  .trow.big{border-top:1px solid var(--line);margin-top:6px;padding-top:12px;color:var(--ink);align-items:baseline}
  .trow.big span:first-child{font-size:14.5px;font-weight:600}
  .trow.big span:last-child{font-family:Fraunces,Georgia,serif;font-size:23px;font-weight:600}
  .free{color:var(--accent);font-weight:600}
  .empty{padding:24px 8px 28px;text-align:center;color:var(--ink-2)}
  .empty svg{color:var(--line-2)}
  .empty p{margin:10px 0 0;font-size:13.5px}

  /* ---------- receipt ---------- */
  .done{padding:34px 26px 30px;text-align:center}
  .tick{width:56px;height:56px;margin:0 auto 16px;border-radius:50%;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center}
  .done h2{font-family:Fraunces,Georgia,serif;font-size:24px;font-weight:600;letter-spacing:-.02em}
  .done p{color:var(--ink-2);font-size:14px;margin:8px 0 0}
  .ref{margin:20px auto 0;max-width:340px;border:1px solid var(--line);border-radius:var(--r);background:var(--paper);padding:12px 14px;display:flex;justify-content:space-between;align-items:center;gap:10px}
  .ref span{font-size:12.5px;color:var(--ink-3)}
  .ref code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:14px;font-weight:600;color:var(--ink)}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  @media (prefers-reduced-motion:reduce){*{animation-duration:.01ms !important;transition-duration:.01ms !important}}
</style>
</head>
<body>

<header class="topbar">
  <div class="brand">
    <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
      <circle cx="13" cy="13" r="12" fill="#14654f"/>
      <path d="M6.5 17.5c2-6 4-6 6.5-6s4.5 0 6.5 6" stroke="#faf8f4" stroke-width="1.6" fill="none" stroke-linecap="round"/>
      <circle cx="13" cy="8.6" r="2.1" fill="#faf8f4"/>
    </svg>
    Mill &amp; Thread
  </div>
  <div class="secure">
    <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <rect x="3" y="7" width="10" height="7" rx="1.6" stroke="currentColor" stroke-width="1.5"/>
      <path d="M5.5 7V5.2a2.5 2.5 0 015 0V7" stroke="currentColor" stroke-width="1.5"/>
    </svg>
    Secure checkout
  </div>
</header>

<main class="wrap">
  <!-- form column -->
  <div class="col-form">
    <div class="head">
      <h1>Checkout</h1>
      <button class="ghost" type="button" id="fill">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2.5 11.5l7-7 2.5 2.5-7 7H2.5v-2.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          <path d="M9.8 3.2l1.2-1.2 2.5 2.5-1.2 1.2" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
        </svg>
        Fill sample details
      </button>
    </div>

    <div id="banners">
      <div class="banner err" id="b-fields">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="8.2" stroke="currentColor" stroke-width="1.6"/><path d="M10 6v5M10 13.6v.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        <div>
          <b id="b-fields-title">Check the highlighted fields</b>
          <div id="b-fields-body"></div>
          <div class="acts" id="b-fields-jumps"></div>
        </div>
      </div>
      <div class="banner err" id="b-net">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M2.5 7.5A10.6 10.6 0 0110 5c2.9 0 5.5 1 7.5 2.5M5.2 10.6A7 7 0 0110 9c1.8 0 3.5.6 4.8 1.6M8 13.6c.6-.4 1.3-.6 2-.6s1.4.2 2 .6M10 17h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <div>
          <b>Payment didn’t go through</b>
          <div id="b-net-body"></div>
          <div class="acts"><button type="button" id="retry">Try again</button></div>
        </div>
      </div>
      <div class="banner warn" id="b-cancel">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="8.2" stroke="currentColor" stroke-width="1.6"/><path d="M7.2 7.2l5.6 5.6M12.8 7.2l-5.6 5.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <div>
          <b>Payment cancelled</b>
          <div>You stopped it before the shop replied. No order was placed and your details are still here.</div>
        </div>
      </div>
      <div class="banner err" id="b-api">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="8.2" stroke="currentColor" stroke-width="1.6"/><path d="M10 6v5M10 13.6v.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        <div><b>Shop connection unavailable</b><div>The storefront script did not load, so orders can’t be placed right now.</div></div>
      </div>
    </div>

    <form class="card" id="form" novalidate>
      <section class="step">
        <div class="step-head">
          <span class="dot" id="dot-contact">1</span>
          <h2>Contact</h2>
          <span class="who skel" id="who"><span class="av">··</span><span id="who-mail">loading</span></span>
        </div>
        <div class="grid">
          <div class="f c3">
            <label for="name">Full name</label>
            <div class="inwrap"><input id="name" name="name" autocomplete="name" placeholder="Alex Rivera" aria-describedby="e-name"></div>
            <p class="msg" id="e-name"></p>
          </div>
          <div class="f c3">
            <label for="email">Email</label>
            <div class="inwrap"><input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" aria-describedby="e-email"></div>
            <p class="msg" id="e-email"></p>
          </div>
        </div>
      </section>

      <section class="step">
        <div class="step-head"><span class="dot" id="dot-ship">2</span><h2>Shipping address</h2></div>
        <div class="grid">
          <div class="f c6">
            <label for="address1">Street address</label>
            <div class="inwrap"><input id="address1" name="address1" autocomplete="address-line1" placeholder="44 Kilnhouse Lane" aria-describedby="e-address1"></div>
            <p class="msg" id="e-address1"></p>
          </div>
          <div class="f c3">
            <label for="city">City</label>
            <div class="inwrap"><input id="city" name="city" autocomplete="address-level2" placeholder="Portland" aria-describedby="e-city"></div>
            <p class="msg" id="e-city"></p>
          </div>
          <div class="f c3">
            <label for="postalCode">Postal code</label>
            <div class="inwrap"><input id="postalCode" name="postalCode" autocomplete="postal-code" placeholder="97204" aria-describedby="e-postalCode"></div>
            <p class="msg" id="e-postalCode"></p>
          </div>
          <div class="f c6">
            <label for="country">Country</label>
            <div class="inwrap">
              <select id="country" name="country" autocomplete="country" aria-describedby="e-country">
                <option value="">Select a country</option>
                <option value="US">United States</option>
                <option value="CA">Canada</option>
                <option value="GB">United Kingdom</option>
                <option value="IE">Ireland</option>
                <option value="DE">Germany</option>
                <option value="FR">France</option>
                <option value="NL">Netherlands</option>
                <option value="AU">Australia</option>
                <option value="JP">Japan</option>
              </select>
              <svg class="chev" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6.5l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <p class="msg" id="e-country"></p>
          </div>
        </div>
      </section>

      <section class="step">
        <div class="step-head">
          <span class="dot" id="dot-pay">3</span><h2>Payment</h2>
          <span class="who">
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="margin-left:6px">
              <rect x="3" y="7" width="10" height="7" rx="1.6" stroke="currentColor" stroke-width="1.5"/>
              <path d="M5.5 7V5.2a2.5 2.5 0 015 0V7" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            Encrypted
          </span>
        </div>
        <div class="grid">
          <div class="f c6">
            <label for="cardNumber">Card number</label>
            <div class="inwrap">
              <input id="cardNumber" name="cardNumber" class="pad-r" inputmode="numeric" autocomplete="cc-number" placeholder="1234 1234 1234 1234" maxlength="23" aria-describedby="e-cardNumber">
              <span class="brandmark" id="mark"></span>
            </div>
            <p class="msg" id="e-cardNumber"></p>
          </div>
          <div class="f c3">
            <label for="cardExpiry">Expiry</label>
            <div class="inwrap"><input id="cardExpiry" name="cardExpiry" inputmode="numeric" autocomplete="cc-exp" placeholder="MM/YY" maxlength="5" aria-describedby="e-cardExpiry"></div>
            <p class="msg" id="e-cardExpiry"></p>
          </div>
          <div class="f c3">
            <label for="cardCvc">Security code</label>
            <div class="inwrap"><input id="cardCvc" name="cardCvc" inputmode="numeric" autocomplete="cc-csc" placeholder="123" maxlength="4" aria-describedby="e-cardCvc h-cvc"></div>
            <p class="msg" id="e-cardCvc"></p>
            <p class="hint" id="h-cvc">3 or 4 digits, from the back of the card</p>
          </div>
        </div>
      </section>

      <div class="pay">
        <div class="payrow">
          <button class="btn" type="submit" id="pay">
            <span id="pay-icon" aria-hidden="true"></span>
            <span id="pay-label">Pay</span>
          </button>
          <button class="btn-sub" type="button" id="cancel" hidden>Cancel</button>
        </div>
        <div class="clock" id="clock" hidden>
          <span class="track"><i></i></span>
          <span id="elapsed" class="money">0s</span>
        </div>
        <p class="foot" id="foot">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1.6" stroke="currentColor" stroke-width="1.4"/><path d="M5.5 7V5.2a2.5 2.5 0 015 0V7" stroke="currentColor" stroke-width="1.4"/></svg>
          Your card is charged only after the shop confirms.
        </p>
      </div>
    </form>

    <div class="card done" id="receipt" hidden>
      <div class="tick">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M7.5 14.6l4.2 4.2 8.8-9.6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h2>Order placed</h2>
      <p id="done-line"></p>
      <div class="ref"><span>Order reference</span><code id="done-id">—</code></div>
    </div>
  </div>

  <!-- summary column -->
  <aside class="col-sum">
    <div class="card sum">
      <h2>Your basket</h2>
      <div id="lines"></div>
      <div class="ship" id="ship" hidden>
        <div class="shiprow">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M1.5 4.5h7v6h-7v-6zM8.5 6.8h3l2 2.2v1.5h-5V6.8z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><circle cx="4.2" cy="12" r="1.3" stroke="currentColor" stroke-width="1.3"/><circle cx="11.3" cy="12" r="1.3" stroke="currentColor" stroke-width="1.3"/></svg>
          <span id="ship-note"></span>
        </div>
        <div class="bar"><i id="ship-bar" style="width:0%"></i></div>
      </div>
      <div class="totals" id="totals" hidden>
        <div class="trow"><span>Subtotal</span><span class="money" id="t-sub">—</span></div>
        <div class="trow"><span>Shipping</span><span class="money" id="t-ship">—</span></div>
        <div class="trow big"><span>Total</span><span class="money" id="t-total">—</span></div>
      </div>
    </div>
  </aside>
</main>

<p class="sr" role="status" aria-live="polite" id="live"></p>

<script>
(function () {
  "use strict";
  var api = window.api;
  var $ = function (s) { return document.querySelector(s); };

  /* ---------- this shop's own catalogue (page content, not backend data) ---------- */
  var ART = {
    moka: '<svg viewBox="0 0 54 54"><rect width="54" height="54" fill="#f2ece1"/><path d="M19 24h16l-2.5 14h-11L19 24z" fill="#14654f"/><path d="M19.5 24l3-8h9l3 8" fill="none" stroke="#20201c" stroke-width="1.5"/><path d="M35 27c4 1 4 6 0 7" fill="none" stroke="#20201c" stroke-width="1.5"/><circle cx="27" cy="14" r="2" fill="#b54708"/></svg>',
    towel: '<svg viewBox="0 0 54 54"><rect width="54" height="54" fill="#eef1ea"/><rect x="13" y="12" width="12" height="30" rx="2" fill="#fff" stroke="#20201c" stroke-width="1.3"/><rect x="28" y="12" width="12" height="30" rx="2" fill="#dfe7dc" stroke="#20201c" stroke-width="1.3"/><path d="M13.5 20h11M13.5 24h11M28.5 20h11M28.5 24h11" stroke="#14654f" stroke-width="1.2"/></svg>',
    candle: '<svg viewBox="0 0 54 54"><rect width="54" height="54" fill="#f6efe3"/><rect x="23" y="18" width="8" height="24" rx="2" fill="#e8c88a" stroke="#20201c" stroke-width="1.3"/><path d="M27 18c0-4 3-4 3-7 0 0-6 1-6 5s3 2 3 2z" fill="#b54708"/></svg>'
  };
  var basket = [
    { id: "sku_moka_6", name: "Stovetop moka pot, 6-cup", note: "Aluminium · Italy", price: 38.00, qty: 1, art: ART.moka },
    { id: "sku_towel_2", name: "Linen tea towels, set of 2", note: "Stonewashed", price: 16.50, qty: 1, art: ART.towel },
    { id: "sku_candle", name: "Beeswax taper candle", note: "9 hour burn", price: 9.00, qty: 2, art: ART.candle }
  ];
  var SHIP_FLAT = 4.90, SHIP_FREE_AT = 90;
  var usd = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });

  /* ---------- state ---------- */
  var KEYS = ["name", "email", "address1", "city", "postalCode", "country", "cardNumber", "cardExpiry", "cardCvc"];
  var LABEL = {
    name: "Full name", email: "Email", address1: "Street address", city: "City",
    postalCode: "Postal code", country: "Country", cardNumber: "Card number",
    cardExpiry: "Expiry", cardCvc: "Security code"
  };
  var GROUP = {
    contact: ["name", "email"],
    ship: ["address1", "city", "postalCode", "country"],
    pay: ["cardNumber", "cardExpiry", "cardCvc"]
  };
  var STEP_NO = { contact: "1", ship: "2", pay: "3" };
  var errors = {};
  var phase = "editing";           // editing | submitting | done
  var ctrl = null, timer = null, t0 = 0;

  var el = {};
  KEYS.forEach(function (k) { el[k] = document.getElementById(k); });

  function say(t) { $("#live").textContent = t; }
  function digits(s) { return (s || "").replace(/\D+/g, ""); }

  /* ---------- basket ---------- */
  function subtotal() { return basket.reduce(function (s, i) { return s + i.price * i.qty; }, 0); }
  function shipping() { return !basket.length || subtotal() >= SHIP_FREE_AT ? 0 : SHIP_FLAT; }
  function total() { return subtotal() + shipping(); }

  var ICON_MINUS = '<svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 6h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>';
  var ICON_PLUS = '<svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 2.5v7M2.5 6h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>';
  var ICON_BIN = '<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 5h9M6 5V3.6h4V5M5 5l.7 8h4.6L11 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  function renderBasket() {
    var box = $("#lines"), locked = phase !== "editing";
    if (!basket.length) {
      box.innerHTML =
        '<div class="empty"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" aria-hidden="true">' +
        '<path d="M3 6h3l2.2 10.5h9.3L20 9H6.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>' +
        '<circle cx="10" cy="20" r="1.4" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="20" r="1.4" stroke="currentColor" stroke-width="1.6"/></svg>' +
        '<p>Your basket is empty.</p></div>';
      $("#ship").hidden = true;
      $("#totals").hidden = true;
      renderPayBar();
      return;
    }
    box.innerHTML = basket.map(function (i, n) {
      return '<div class="line">' +
        '<div class="thumb">' + i.art + '</div>' +
        '<div class="lmid"><div class="lname">' + i.name + '</div>' +
        '<div class="lmeta">' + i.note + ' · ' + usd.format(i.price) + '</div>' +
        '<div class="qty">' +
        '<button type="button" data-dec="' + n + '" aria-label="One fewer ' + i.name + '"' + (locked || i.qty < 2 ? " disabled" : "") + '>' + ICON_MINUS + '</button>' +
        '<span aria-label="Quantity">' + i.qty + '</span>' +
        '<button type="button" data-inc="' + n + '" aria-label="One more ' + i.name + '"' + (locked ? " disabled" : "") + '>' + ICON_PLUS + '</button>' +
        '</div></div>' +
        '<div class="lright"><div class="lprice money">' + usd.format(i.price * i.qty) + '</div>' +
        '<button class="rm" type="button" data-rm="' + n + '" aria-label="Remove ' + i.name + '"' + (locked ? " disabled" : "") + '>' + ICON_BIN + '</button>' +
        '</div></div>';
    }).join("");

    var gap = SHIP_FREE_AT - subtotal();
    $("#ship").hidden = false;
    if (gap > 0) {
      $("#ship-note").textContent = usd.format(gap) + " to free shipping";
      $("#ship-bar").style.width = Math.max(3, (subtotal() / SHIP_FREE_AT) * 100).toFixed(1) + "%";
    } else {
      $("#ship-note").innerHTML = '<span class="free">Free shipping unlocked</span>';
      $("#ship-bar").style.width = "100%";
    }
    $("#totals").hidden = false;
    $("#t-sub").textContent = usd.format(subtotal());
    $("#t-ship").innerHTML = shipping() === 0 ? '<span class="free">Free</span>' : usd.format(shipping());
    $("#t-total").textContent = usd.format(total());
    renderPayBar();
  }

  $("#lines").addEventListener("click", function (ev) {
    if (phase !== "editing") return;
    var b = ev.target.closest("button");
    if (!b) return;
    if (b.dataset.inc != null) basket[+b.dataset.inc].qty++;
    else if (b.dataset.dec != null) basket[+b.dataset.dec].qty--;
    else if (b.dataset.rm != null) {
      var gone = basket.splice(+b.dataset.rm, 1)[0];
      say(gone.name + " removed. Total " + usd.format(total()));
    } else return;
    renderBasket();
  });

  /* ---------- card brand ---------- */
  var MARKS = {
    visa: '<svg width="30" height="19" viewBox="0 0 30 19" role="img" aria-label="Visa"><rect width="30" height="19" rx="3" fill="#1434cb"/><text x="15" y="13.2" font-family="Inter,sans-serif" font-size="8.2" font-weight="700" fill="#fff" text-anchor="middle" letter-spacing=".5">VISA</text></svg>',
    mastercard: '<svg width="30" height="19" viewBox="0 0 30 19" role="img" aria-label="Mastercard"><rect width="30" height="19" rx="3" fill="#f4f1ec"/><circle cx="12.4" cy="9.5" r="5.4" fill="#eb001b"/><circle cx="17.6" cy="9.5" r="5.4" fill="#f79e1b" fill-opacity=".85"/></svg>',
    amex: '<svg width="30" height="19" viewBox="0 0 30 19" role="img" aria-label="American Express"><rect width="30" height="19" rx="3" fill="#016fd0"/><text x="15" y="13" font-family="Inter,sans-serif" font-size="6.8" font-weight="700" fill="#fff" text-anchor="middle" letter-spacing=".3">AMEX</text></svg>',
    unknown: '<svg width="30" height="19" viewBox="0 0 30 19" aria-hidden="true"><rect x=".8" y=".8" width="28.4" height="17.4" rx="2.6" fill="#fff" stroke="#d3cbbd" stroke-width="1.2"/><path d="M1 6.6h28" stroke="#d3cbbd" stroke-width="1.2"/><rect x="4" y="10.6" width="8" height="2" rx="1" fill="#d3cbbd"/></svg>'
  };
  function brandOf(num) {
    var d = digits(num);
    if (/^4/.test(d)) return "visa";
    if (/^(5[1-5]|2[2-7])/.test(d)) return "mastercard";
    if (/^3[47]/.test(d)) return "amex";
    return "unknown";
  }
  function groupCard(v) {
    var d = digits(v).slice(0, 19), out = [];
    if (brandOf(d) === "amex") out = [d.slice(0, 4), d.slice(4, 10), d.slice(10, 15)];
    else for (var i = 0; i < d.length; i += 4) out.push(d.slice(i, i + 4));
    return out.filter(Boolean).join(" ");
  }

  /* ---------- validation ---------- */
  function check(k) {
    var v = (el[k].value || "").trim();
    switch (k) {
      case "name": return v ? null : "Enter the name for this order";
      case "email":
        if (!v) return "Enter your email";
        return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v) ? null : "Use a format like name@example.com";
      case "address1": return v ? null : "Enter a street address";
      case "city": return v ? null : "Enter a city";
      case "postalCode": return v ? null : "Enter a postal code";
      case "country": return v ? null : "Choose a country";
      case "cardNumber": {
        var d = digits(v);
        if (!d) return "Enter your card number";
        return d.length >= 13 && d.length <= 19 ? null : "A card number has 13 to 19 digits";
      }
      case "cardExpiry": {
        if (!v) return "Enter the expiry date";
        var m = v.match(/^(\d{2})\/(\d{2})$/);
        if (!m) return "Use MM/YY";
        var mm = +m[1], yy = 2000 + +m[2], now = new Date();
        if (mm < 1 || mm > 12) return "Month must be 01 to 12";
        if (yy < now.getFullYear() || (yy === now.getFullYear() && mm < now.getMonth() + 1)) return "This card has expired";
        return null;
      }
      case "cardCvc": {
        var c = digits(v);
        if (!c) return "Enter the security code";
        return c.length >= 3 && c.length <= 4 ? null : "The code is 3 or 4 digits";
      }
    }
    return null;
  }

  var ICON_WARN = '<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6.6" stroke="currentColor" stroke-width="1.5"/><path d="M8 4.8v4M8 10.7v.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>';

  function paintField(k) {
    var msg = errors[k] || "", box = document.getElementById("e-" + k);
    el[k].setAttribute("aria-invalid", msg ? "true" : "false");
    if (msg) {
      box.className = "msg on";
      box.innerHTML = ICON_WARN + "<span>" + msg + "</span>";
    } else {
      box.className = "msg";
      box.textContent = "";
    }
  }

  function paintDots() {
    Object.keys(GROUP).forEach(function (g) {
      var fields = GROUP[g], dot = document.getElementById("dot-" + g);
      var bad = fields.some(function (k) { return errors[k]; });
      var full = fields.every(function (k) { return !check(k); });
      dot.className = "dot" + (bad ? " bad" : full ? " done" : "");
      if (bad) dot.innerHTML = '<svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 4.4v5M8 11.4v.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';
      else if (full) dot.innerHTML = '<svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 8.4l2.6 2.6L12 5.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      else dot.textContent = STEP_NO[g];
    });
  }

  function paintAll() { KEYS.forEach(paintField); paintDots(); }

  function banner(id, on) { document.getElementById(id).classList.toggle("on", !!on); }
  function clearBanners() { ["b-fields", "b-net", "b-cancel"].forEach(function (i) { banner(i, false); }); }
  function badFields() { return KEYS.filter(function (k) { return errors[k]; }); }

  function showFieldBanner(source, extraKeys) {
    var bad = badFields(), extra = extraKeys || [];
    if (!bad.length && !extra.length) { banner("b-fields", false); return; }
    var n = bad.length + extra.length;
    $("#b-fields-title").textContent = n === 1 ? "One field needs a fix" : n + " fields need a fix";
    var body = source === "server" ? "The shop checked your details and sent these back." : "";
    if (extra.length) body += (body ? " " : "") + "Also flagged: " + extra.join(", ") + ".";
    $("#b-fields-body").textContent = body;
    $("#b-fields-jumps").innerHTML = bad.map(function (k) {
      return '<button class="jump" type="button" data-go="' + k + '">' + LABEL[k] + "</button>";
    }).join("");
    banner("b-fields", true);
  }

  $("#b-fields-jumps").addEventListener("click", function (ev) {
    var b = ev.target.closest("[data-go]");
    if (!b || phase === "submitting") return;
    var t = el[b.dataset.go];
    t.focus();
    t.scrollIntoView({ block: "center", behavior: "smooth" });
  });

  /* ---------- inputs ---------- */
  KEYS.forEach(function (k) {
    var input = el[k];
    input.addEventListener("input", function () {
      if (k === "cardNumber") {
        var atEnd = input.selectionStart === input.value.length;
        input.value = groupCard(input.value);
        $("#mark").innerHTML = MARKS[brandOf(input.value)];
        if (atEnd) input.setSelectionRange(input.value.length, input.value.length);
      } else if (k === "cardExpiry") {
        var d = digits(input.value).slice(0, 4);
        input.value = d.length > 2 ? d.slice(0, 2) + "/" + d.slice(2) : d;
      } else if (k === "cardCvc") {
        input.value = digits(input.value).slice(0, 4);
      }
      if (errors[k] && !check(k)) {          // clear the error as soon as it is fixed
        delete errors[k];
        paintField(k);
        paintDots();
        showFieldBanner("local");
      }
      banner("b-net", false);
      banner("b-cancel", false);
    });
    input.addEventListener("blur", function () {
      var m = check(k);
      if (m) errors[k] = m; else delete errors[k];
      paintField(k);
      paintDots();
    });
  });
  $("#mark").innerHTML = MARKS.unknown;

  $("#fill").addEventListener("click", function () {
    var sample = {
      name: el.name.value || "Alex Rivera",
      email: el.email.value || "alex@example.com",
      address1: "44 Kilnhouse Lane",
      city: "Portland",
      postalCode: "97204",
      country: "US",
      cardNumber: "4242 4242 4242 4242",
      cardExpiry: "04/29",
      cardCvc: "123"
    };
    Object.keys(sample).forEach(function (k) { el[k].value = sample[k]; delete errors[k]; });
    $("#mark").innerHTML = MARKS[brandOf(el.cardNumber.value)];
    clearBanners();
    paintAll();
    say("Sample details filled in.");
  });

  /* ---------- pay bar ---------- */
  var ICON_CARD = '<svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1.8" y="3.5" width="12.4" height="9" rx="1.8" stroke="currentColor" stroke-width="1.5"/><path d="M1.8 6.8h12.4" stroke="currentColor" stroke-width="1.5"/></svg>';
  var ICON_SPIN = '<svg class="spin" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6.2" stroke="rgba(255,255,255,.35)" stroke-width="2"/><path d="M14.2 8A6.2 6.2 0 008 1.8" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>';

  function renderPayBar() {
    var busy = phase === "submitting", pay = $("#pay");
    pay.classList.toggle("busy", busy);
    pay.disabled = busy || !basket.length;
    pay.setAttribute("aria-busy", busy ? "true" : "false");
    $("#cancel").hidden = !busy;
    $("#clock").hidden = !busy;
    $("#foot").hidden = busy;
    $("#fill").disabled = busy;
    KEYS.forEach(function (k) { el[k].disabled = busy; });
    if (busy) {
      $("#pay-icon").innerHTML = ICON_SPIN;
      $("#pay-label").textContent = "Processing";
    } else if (!basket.length) {
      $("#pay-icon").innerHTML = "";
      $("#pay-label").textContent = "Basket is empty";
    } else {
      $("#pay-icon").innerHTML = ICON_CARD;
      $("#pay-label").textContent = "Pay " + usd.format(total());
    }
  }

  function startClock() {
    t0 = Date.now();
    $("#elapsed").textContent = "0s";
    timer = setInterval(function () {
      $("#elapsed").textContent = Math.round((Date.now() - t0) / 1000) + "s";
    }, 500);
  }
  function stopClock() { if (timer) { clearInterval(timer); timer = null; } }

  /* ---------- submit ---------- */
  function payload() {
    return {
      email: el.email.value.trim(),
      name: el.name.value.trim(),
      address1: el.address1.value.trim(),
      city: el.city.value.trim(),
      postalCode: el.postalCode.value.trim(),
      country: el.country.value,
      cardNumber: digits(el.cardNumber.value),
      cardExpiry: el.cardExpiry.value.trim(),
      cardCvc: digits(el.cardCvc.value),
      items: basket.map(function (i) {
        return { id: i.id, name: i.name, quantity: i.qty, unitPrice: i.price };
      })
    };
  }

  function succeed(orderId) {
    stopClock();
    phase = "done";
    ctrl = null;
    clearBanners();
    var items = basket.reduce(function (s, i) { return s + i.qty; }, 0);
    $("#done-line").textContent =
      items + (items === 1 ? " item" : " items") + " · " + usd.format(total()) +
      " · shipping to " + (el.city.value.trim() || "your address");
    $("#done-id").textContent = orderId;
    $("#form").hidden = true;
    $("#fill").hidden = true;
    $("#receipt").hidden = false;
    renderBasket();
    say("Order placed. Reference " + orderId + ".");
    $("#receipt").scrollIntoView({ block: "center", behavior: "smooth" });
  }

  function failNetwork(err) {
    var reason = (err && err.message) ? err.message : "The shop did not respond";
    $("#b-net-body").textContent = reason +
      " — no order was placed and your card was not charged. Your details are still filled in.";
    banner("b-net", true);
    say("Payment failed: " + reason + ". You can try again.");
    $("#retry").focus();
  }

  function submit() {
    if (phase !== "editing") return;                    // only one attempt in flight
    if (!api || typeof api.submitOrder !== "function") { banner("b-api", true); return; }
    if (!basket.length) { say("Add an item before paying."); return; }

    errors = {};
    KEYS.forEach(function (k) { var m = check(k); if (m) errors[k] = m; });
    paintAll();
    if (badFields().length) {
      banner("b-net", false);
      banner("b-cancel", false);
      showFieldBanner("local");
      var first = badFields()[0];
      el[first].focus();
      el[first].scrollIntoView({ block: "center", behavior: "smooth" });
      say(badFields().length + " fields need a fix before paying.");
      return;
    }

    clearBanners();
    phase = "submitting";
    ctrl = new AbortController();
    renderBasket();
    startClock();
    say("Sending your order to the shop.");

    api.submitOrder(payload(), { signal: ctrl.signal }).then(function (res) {
      succeed(res && res.orderId ? res.orderId : "not returned");
    }, function (err) {
      stopClock();
      phase = "editing";
      ctrl = null;
      renderBasket();

      if (err && (err.name === "AbortError" || err.code === 20)) {
        banner("b-cancel", true);
        say("Payment cancelled. Nothing was ordered.");
        $("#pay").focus();
        return;
      }
      if (err && err.code === "VALIDATION" && err.fields) {
        var unknown = [];
        Object.keys(err.fields).forEach(function (k) {
          if (el[k]) errors[k] = String(err.fields[k]);
          else unknown.push(k);
        });
        paintAll();
        showFieldBanner("server", unknown);
        var bad = badFields();
        if (bad.length) {
          el[bad[0]].focus();
          el[bad[0]].scrollIntoView({ block: "center", behavior: "smooth" });
        }
        say("The shop rejected " + (bad.length + unknown.length) + " of your details.");
        return;
      }
      failNetwork(err);
    });
  }

  $("#form").addEventListener("submit", function (ev) { ev.preventDefault(); submit(); });
  $("#retry").addEventListener("click", function () { banner("b-net", false); submit(); });
  $("#cancel").addEventListener("click", function () {
    if (!ctrl) return;
    ctrl.abort();
    say("Cancelling.");
  });

  /* ---------- boot ---------- */
  renderBasket();
  paintDots();

  if (api && typeof api.getUser === "function") {
    api.getUser().then(function (u) {
      var who = $("#who");
      if (!u) { who.hidden = true; return; }
      if (!el.name.value && u.name) el.name.value = u.name;
      if (!el.email.value && u.email) el.email.value = u.email;
      who.classList.remove("skel");
      $("#who-mail").textContent = u.email || u.name || "signed in";
      who.querySelector(".av").textContent = (u.name || "?")
        .split(/\s+/).slice(0, 2).map(function (p) { return p.charAt(0); }).join("").toUpperCase();
      paintDots();
      renderPayBar();
    }, function () {
      $("#who").hidden = true;               // not fatal: the fields stay editable
    });
  } else {
    $("#who").hidden = true;
    banner("b-api", true);
  }
})();
</script>
</body>
</html>
