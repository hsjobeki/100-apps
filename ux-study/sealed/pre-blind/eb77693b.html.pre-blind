<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Workspace setup</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#F3EFE7; --surface:#FFFFFF; --sunk:#FAF7F1;
  --ink:#14161A; --muted:#6A6F79; --line:#E4DDCF;
  --accent:#C0502F; --accent-soft:#F7E7DF; --accent-deep:#8E3A1F;
  --ok:#1F6F5C; --ok-soft:#E1F0EA;
  --danger:#AE3527; --danger-soft:#F9E5E1;
  --track:#E7E0D2;
  --r:14px; --shadow:0 1px 2px rgba(20,22,26,.05), 0 8px 24px -16px rgba(20,22,26,.30);
  --sans:'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --serif:'Fraunces', Georgia, 'Times New Roman', serif;
}
@media (prefers-color-scheme: dark){
  :root{
    --paper:#15171C; --surface:#1D2026; --sunk:#23262D;
    --ink:#EFEAE1; --muted:#9BA1AC; --line:#2E333C;
    --accent:#E0765A; --accent-soft:#33241F; --accent-deep:#F0A183;
    --ok:#5FC0A5; --ok-soft:#1C2C29;
    --danger:#E8796A; --danger-soft:#33201D;
    --track:#2E333C;
    --shadow:0 1px 2px rgba(0,0,0,.4), 0 10px 30px -18px rgba(0,0,0,.8);
  }
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:var(--paper); color:var(--ink); font-family:var(--sans);
  font-size:15px; line-height:1.5; -webkit-font-smoothing:antialiased;
  background-image:radial-gradient(circle at 12% -8%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 42%);
}
button{font:inherit;color:inherit}
h1,h2,h3{margin:0;font-family:var(--serif);font-weight:600;letter-spacing:-.01em}
p{margin:0}
a{color:inherit}

.top{display:flex;align-items:center;gap:10px;padding:22px 28px 6px;max-width:1080px;margin:0 auto}
.mark{width:26px;height:26px;color:var(--accent);flex:none}
.wordmark{font-family:var(--serif);font-size:17px;font-weight:600;letter-spacing:.01em}
.shell{max-width:1080px;margin:0 auto;padding:12px 28px 56px;display:grid;grid-template-columns:252px 1fr;gap:28px;align-items:start}

/* rail */
.rail{position:sticky;top:20px;display:flex;flex-direction:column;gap:18px}
.ringwrap{display:flex;align-items:center;gap:12px}
.ring{width:58px;height:58px;flex:none;transform:rotate(-90deg)}
.ring .bg{fill:none;stroke:var(--track);stroke-width:5}
.ring .fg{fill:none;stroke:var(--accent);stroke-width:5;stroke-linecap:round;transition:stroke-dashoffset .45s cubic-bezier(.3,.9,.3,1)}
.ringtxt{font-size:13px;color:var(--muted)}
.ringtxt b{display:block;font-size:15px;color:var(--ink);font-weight:600}
.steps{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px}
.steps li{position:relative}
.steps li::after{content:"";position:absolute;left:29px;top:44px;bottom:0;width:2px;background:var(--track);border-radius:2px}
.steps li:last-child::after{display:none}
.steps li.done::after{background:var(--ok)}
.snav{display:flex;gap:12px;align-items:center;width:100%;background:none;border:0;padding:8px 10px;border-radius:12px;cursor:pointer;text-align:left}
.snav:hover:not(:disabled){background:color-mix(in srgb, var(--ink) 5%, transparent)}
.snav:disabled{cursor:not-allowed;opacity:.5}
.snav:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.snav>.bead{width:28px;height:28px;flex:none;border-radius:50%;display:grid;place-items:center;border:2px solid var(--track);background:var(--surface);font-size:12px;font-weight:600;color:var(--muted)}
.bead .ic{width:15px;height:15px}
li.active .snav>.bead{border-color:var(--accent);color:var(--accent);background:var(--accent-soft);box-shadow:0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent)}
li.done .snav>.bead{border-color:var(--ok);background:var(--ok);color:#fff}
.stxt{min-width:0}
.snav b{display:block;font-size:14px;font-weight:600}
.ssub{display:block;font-size:12.5px;color:var(--muted)}
li.active .snav b{color:var(--accent-deep)}

.railjob{border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:10px 12px;display:flex;flex-direction:column;gap:7px;box-shadow:var(--shadow)}
.rj-head{display:flex;align-items:center;gap:7px;font-size:12.5px;font-weight:500}

/* panel */
.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);padding:26px 28px 24px;min-height:430px}
.panel h1{font-size:25px;line-height:1.2}
.lede{color:var(--muted);font-size:13.5px;margin-top:6px}
.sec{margin-top:22px}
.flabel{display:block;font-size:12.5px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}

.who{display:flex;align-items:center;gap:13px;background:var(--sunk);border:1px solid var(--line);border-radius:12px;padding:12px 14px}
.av{width:40px;height:40px;border-radius:12px;flex:none;display:grid;place-items:center;background:var(--accent);color:#fff;font-weight:600;font-size:15px;letter-spacing:.02em}
.who .nm{font-weight:600}
.who .em{font-size:13px;color:var(--muted)}
.plan{font-size:12px;font-weight:600;padding:3px 9px;border-radius:999px;background:var(--accent-soft);color:var(--accent-deep);border:1px solid color-mix(in srgb, var(--accent) 28%, transparent)}
.who .plan{margin-left:auto}

.sk{background:linear-gradient(90deg,var(--track) 0%, color-mix(in srgb,var(--track) 45%, var(--surface)) 50%, var(--track) 100%);background-size:200% 100%;animation:sh 1.1s linear infinite;border-radius:6px}
@keyframes sh{from{background-position:200% 0}to{background-position:-200% 0}}
.sk-l{height:11px}

input[type=text]{
  width:100%;font:inherit;color:var(--ink);background:var(--surface);
  border:1px solid var(--line);border-radius:11px;padding:11px 13px;
}
input[type=text]:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 18%, transparent)}
input[aria-invalid=true]{border-color:var(--danger);box-shadow:0 0 0 3px color-mix(in srgb,var(--danger) 15%, transparent)}
.hint{font-size:12.5px;color:var(--muted)}
.fielderr{display:flex;gap:6px;align-items:flex-start;font-size:13px;color:var(--danger);margin-top:8px;font-weight:500}
.fielderr .ic{width:15px;height:15px;flex:none;margin-top:2px}
.linkbtn{background:none;border:0;padding:0 0 0 6px;font-size:13px;font-weight:600;color:var(--danger);text-decoration:underline;cursor:pointer}

.seg{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.seg button{
  display:flex;flex-direction:column;gap:7px;align-items:flex-start;
  border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:11px 12px;cursor:pointer;
}
.seg button .ic{width:20px;height:20px;color:var(--muted)}
.seg button b{font-size:13.5px;font-weight:600}
.seg button:hover{border-color:color-mix(in srgb,var(--accent) 45%, var(--line))}
.seg button[aria-checked=true]{border-color:var(--accent);background:var(--accent-soft)}
.seg button[aria-checked=true] .ic{color:var(--accent)}
.seg button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

.acts{display:flex;align-items:center;gap:12px;margin-top:26px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:8px;border-radius:11px;padding:10px 16px;border:1px solid transparent;cursor:pointer;font-weight:600;font-size:14px;text-decoration:none}
.btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.btn .ic{width:16px;height:16px}
.btn-p{background:var(--accent);color:#fff}
.btn-p:hover:not(:disabled){background:var(--accent-deep)}
.btn-s{background:var(--surface);border-color:var(--line);color:var(--ink)}
.btn-s:hover:not(:disabled){background:var(--sunk)}
.btn-g{background:none;color:var(--muted);padding:10px 8px}
.btn-g:hover:not(:disabled){color:var(--ink)}
.btn-d{background:var(--surface);border-color:color-mix(in srgb,var(--danger) 40%, var(--line));color:var(--danger)}
.btn:disabled{opacity:.55;cursor:not-allowed}
.spin{width:15px;height:15px;flex:none;border-radius:50%;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;animation:sp .7s linear infinite}
.btn-s .spin,.btn-g .spin,.btn-d .spin{border-color:color-mix(in srgb,var(--ink) 20%, transparent);border-top-color:var(--accent)}
@keyframes sp{to{transform:rotate(360deg)}}

.alert{display:flex;gap:9px;align-items:flex-start;border-radius:12px;padding:11px 13px;font-size:13.5px;border:1px solid}
.alert .ic{width:17px;height:17px;flex:none;margin-top:1px}
.alert b{display:block;font-weight:600}
.alert-err{background:var(--danger-soft);border-color:color-mix(in srgb,var(--danger) 30%, transparent);color:var(--danger)}
.alert-ok{background:var(--ok-soft);border-color:color-mix(in srgb,var(--ok) 28%, transparent);color:var(--ok)}
.alert-i{background:var(--sunk);border-color:var(--line);color:var(--muted)}
.alert .body{flex:1;min-width:0}
.alert-ok .body p,.alert-err .body p{color:color-mix(in srgb,var(--ink) 55%, currentColor)}

/* import */
.drop{
  border:2px dashed color-mix(in srgb,var(--accent) 35%, var(--line));border-radius:14px;background:var(--sunk);
  padding:26px 20px;display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center;
}
.drop.over{border-color:var(--accent);background:var(--accent-soft)}
.drop .art{width:88px;height:56px;color:var(--accent)}
.drop b{font-size:15px}
.drop .row{display:flex;gap:9px;margin-top:10px}

.card{border:1px solid var(--line);border-radius:12px;background:var(--surface);padding:14px 15px}
.filerow{display:flex;align-items:center;gap:11px}
.fico{width:34px;height:34px;flex:none;border-radius:9px;background:var(--accent-soft);color:var(--accent-deep);display:grid;place-items:center}
.fico .ic{width:17px;height:17px}
.fmeta{min-width:0;flex:1}
.fmeta b{display:block;font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fmeta span{font-size:12.5px;color:var(--muted)}

.chip{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;padding:3px 10px;border-radius:999px;border:1px solid;white-space:nowrap}
.dot{width:7px;height:7px;border-radius:50%;flex:none;background:currentColor}
.c-run{color:var(--accent-deep);background:var(--accent-soft);border-color:color-mix(in srgb,var(--accent) 30%, transparent)}
.c-run .dot{animation:pulse 1.1s ease-in-out infinite}
@keyframes pulse{50%{opacity:.25;transform:scale(.7)}}
.c-q{color:var(--muted);background:var(--sunk);border-color:var(--line)}
.c-ok{color:var(--ok);background:var(--ok-soft);border-color:color-mix(in srgb,var(--ok) 28%, transparent)}
.c-bad{color:var(--danger);background:var(--danger-soft);border-color:color-mix(in srgb,var(--danger) 30%, transparent)}

.bar{height:8px;border-radius:99px;background:var(--track);overflow:hidden}
.bar i{display:block;height:100%;border-radius:99px;background:var(--accent);width:0%;transition:width .3s ease}
.bar.ok i{background:var(--ok)}
.bar.bad i{background:var(--danger)}
.bar.indet i{width:38%;animation:slide 1.15s ease-in-out infinite}
@keyframes slide{0%{transform:translateX(-110%)}100%{transform:translateX(280%)}}
.bar.sm{height:5px}
.barrow{display:flex;align-items:center;justify-content:space-between;font-size:12.5px;color:var(--muted);margin-bottom:6px}
.pct{font-variant-numeric:tabular-nums;font-weight:600;color:var(--ink)}
.stack{display:flex;flex-direction:column;gap:13px}

.sum{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
.sum li{display:flex;align-items:center;gap:11px;padding:11px 2px;border-bottom:1px solid var(--line)}
.sum li:last-child{border-bottom:0}
.sum .k{font-size:12.5px;color:var(--muted);width:120px;flex:none}
.sum .v{font-weight:600;font-size:14px;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tick{width:22px;height:22px;flex:none;border-radius:50%;display:grid;place-items:center;background:var(--ok-soft);color:var(--ok)}
.tick.skip{background:var(--sunk);color:var(--muted)}
.tick .ic{width:13px;height:13px}

/* workspace */
.wshead{display:flex;align-items:center;gap:12px;margin-bottom:20px}
.wshead h1{font-size:23px}
.wshead .plan{margin-left:auto}
.empty{display:flex;flex-direction:column;align-items:center;text-align:center;padding:30px 20px 34px;border:1px solid var(--line);border-radius:14px;background:var(--sunk)}
.empty .art{width:230px;height:130px}
.empty h2{font-size:21px;margin-top:14px}
.empty .sub{color:var(--muted);font-size:14px;margin-top:7px;max-width:44ch}
.empty .row{display:flex;gap:10px;margin-top:18px;flex-wrap:wrap;justify-content:center}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px}
.pcard{border:1px solid var(--line);border-radius:12px;padding:14px;background:var(--surface);display:flex;flex-direction:column;gap:9px}
.pcard b{font-size:14.5px}
.pcard span{font-size:12.5px;color:var(--muted)}
.swatch{height:6px;border-radius:99px;background:var(--accent);width:44px}

dialog{border:1px solid var(--line);border-radius:14px;background:var(--surface);color:var(--ink);padding:22px;max-width:390px;box-shadow:0 24px 60px -20px rgba(0,0,0,.45)}
dialog::backdrop{background:rgba(20,22,26,.42)}
dialog h2{font-size:19px}
dialog .sub{color:var(--muted);font-size:13.5px;margin-top:8px}
.dacts{display:flex;gap:9px;justify-content:flex-end;margin-top:20px}

.banner{display:flex;align-items:center;gap:10px;background:var(--ok-soft);border:1px solid color-mix(in srgb,var(--ok) 28%, transparent);color:var(--ok);border-radius:12px;padding:10px 12px;font-size:13.5px;font-weight:500;margin-bottom:18px}
.banner .btn{margin-left:auto}

.ic{width:16px;height:16px;display:inline-block;vertical-align:middle}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
[hidden]{display:none !important}

@media (max-width:820px){
  .shell{grid-template-columns:1fr;gap:18px;padding:12px 16px 40px}
  .top{padding:18px 16px 4px}
  .rail{position:static;flex-direction:row;align-items:center;gap:10px}
  .ringwrap .ringtxt{display:none}
  .steps{flex-direction:row;flex:1;gap:0}
  .steps li{flex:1}
  .steps li::after{left:auto;right:0;top:20px;bottom:auto;width:100%;height:2px;z-index:-1}
  .snav{flex-direction:column;align-items:center;gap:6px;padding:4px 2px;text-align:center}
  .ssub{display:none}
  .snav b{font-size:12px}
  .railjob{display:none}
  .panel{padding:20px 17px 22px;min-height:0}
  .seg{grid-template-columns:1fr}
  .seg button{flex-direction:row;align-items:center;gap:10px}
  .empty .art{width:180px;height:105px}
}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms !important;transition-duration:.01ms !important}}
</style>
</head>
<body>

<svg class="sprite" aria-hidden="true" width="0" height="0" focusable="false" style="position:absolute">
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-alert" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.2" fill="none" stroke="currentColor" stroke-width="1.9"/><path d="M12 7.3v6M12 16.4v.1" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/></symbol>
  <symbol id="i-file" viewBox="0 0 24 24"><path d="M13.5 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8.5L13.5 3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M13.3 3.3V9h5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></symbol>
  <symbol id="i-redo" viewBox="0 0 24 24"><path d="M20 12a8 8 0 11-2.6-5.9M20 4v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-x" viewBox="0 0 24 24"><path d="M6.5 6.5l11 11M17.5 6.5l-11 11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></symbol>
  <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M4.5 12h14M13 6.5l5.5 5.5L13 17.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-board" viewBox="0 0 24 24"><rect x="3.2" y="4.2" width="5" height="15.6" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="9.5" y="4.2" width="5" height="10" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.8"/><rect x="15.8" y="4.2" width="5" height="13" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.8"/></symbol>
  <symbol id="i-list" viewBox="0 0 24 24"><path d="M4 6.5h16M4 12h16M4 17.5h10" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></symbol>
  <symbol id="i-time" viewBox="0 0 24 24"><path d="M3.5 7.5h11M6.5 12.5h13M3.5 17.5h8" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><circle cx="17" cy="7.5" r="2.1" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="6" cy="17.5" r="2.1" fill="none" stroke="currentColor" stroke-width="1.7"/></symbol>
  <symbol id="i-dl" viewBox="0 0 24 24"><path d="M12 4v11M7 10.5l5 5 5-5M4.5 19.5h15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
</svg>

<header class="top">
  <svg class="mark" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12.5" fill="none" stroke="currentColor" stroke-width="2.6"/><path d="M1.5 16h29" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/><circle cx="16" cy="16" r="3.4" fill="currentColor"/></svg>
  <span class="wordmark">Meridian</span>
</header>

<div class="shell">

  <aside class="rail" id="rail" aria-label="Setup progress">
    <div class="ringwrap">
      <svg class="ring" viewBox="0 0 64 64" role="img" aria-labelledby="ringTitle">
        <title id="ringTitle">Setup progress</title>
        <circle class="bg" cx="32" cy="32" r="26"></circle>
        <circle class="fg" id="ringArc" cx="32" cy="32" r="26" stroke-dasharray="163.4" stroke-dashoffset="163.4"></circle>
      </svg>
      <div class="ringtxt"><b id="ringNum">Step 1 of 3</b>Setup</div>
    </div>

    <ol class="steps" id="steps">
      <li id="li1" class="active">
        <button class="snav" type="button" data-go="1"><span class="bead" id="bead1">1</span><span class="stxt"><b>Profile</b><span class="ssub">Name the workspace</span></span></button>
      </li>
      <li id="li2">
        <button class="snav" type="button" data-go="2" disabled><span class="bead" id="bead2">2</span><span class="stxt"><b>Import</b><span class="ssub">Bring in work</span></span></button>
      </li>
      <li id="li3">
        <button class="snav" type="button" data-go="3" disabled><span class="bead" id="bead3">3</span><span class="stxt"><b>Finish</b><span class="ssub">Open workspace</span></span></button>
      </li>
    </ol>

    <div class="railjob" id="railJob" hidden>
      <div class="rj-head">
        <span class="chip c-run" id="rjChip"><span class="dot"></span><span id="rjLabel">Uploading</span></span>
        <span class="pct" id="rjPct" style="margin-left:auto;font-size:12px">0%</span>
      </div>
      <div class="bar sm" id="rjBar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Import progress"><i id="rjFill"></i></div>
    </div>
  </aside>

  <section class="panel" id="panel">

    <div class="banner" id="doneBanner" hidden>
      <svg class="ic" aria-hidden="true"><use href="#i-check"/></svg>
      <span>Setup is already finished.</span>
      <button class="btn btn-s" type="button" id="btnSkipToWs">Open workspace</button>
    </div>

    <!-- step 1 -->
    <div id="p1">
      <h1>Set up your workspace</h1>
      <p class="lede">Three steps. Everything here is editable later.</p>

      <div class="sec">
        <span class="flabel">Account</span>
        <div class="who" id="who" aria-busy="true">
          <div class="sk" id="whoAvSk" style="width:40px;height:40px;border-radius:12px;flex:none"></div>
          <div class="av" id="whoAv" hidden>--</div>
          <div style="flex:1;min-width:0">
            <div id="whoSk">
              <div class="sk sk-l" style="width:130px"></div>
              <div class="sk sk-l" style="width:180px;margin-top:7px;height:9px"></div>
            </div>
            <div id="whoReal" hidden>
              <div class="nm" id="whoName"></div>
              <div class="em" id="whoMail"></div>
            </div>
          </div>
          <span class="plan" id="whoPlan" hidden></span>
        </div>
        <div class="fielderr" id="whoErr" hidden role="alert">
          <svg class="ic" aria-hidden="true"><use href="#i-alert"/></svg>
          <span style="flex:1"><span id="whoErrMsg"></span><button class="linkbtn" type="button" id="btnWhoRetry">Retry</button></span>
        </div>
      </div>

      <form id="f1" novalidate>
        <div class="sec">
          <label class="flabel" for="wsName">Workspace name</label>
          <input type="text" id="wsName" value="My workspace" maxlength="48" autocomplete="off">
          <div class="fielderr" id="wsErr" hidden role="alert"><svg class="ic" aria-hidden="true"><use href="#i-alert"/></svg><span id="wsErrMsg"></span></div>
        </div>

        <div class="sec">
          <span class="flabel" id="viewLbl">Default view</span>
          <div class="seg" role="radiogroup" aria-labelledby="viewLbl" id="seg">
            <button type="button" role="radio" aria-checked="true" data-style="board"><svg class="ic" aria-hidden="true"><use href="#i-board"/></svg><b>Board</b></button>
            <button type="button" role="radio" aria-checked="false" data-style="list"><svg class="ic" aria-hidden="true"><use href="#i-list"/></svg><b>List</b></button>
            <button type="button" role="radio" aria-checked="false" data-style="timeline"><svg class="ic" aria-hidden="true"><use href="#i-time"/></svg><b>Timeline</b></button>
          </div>
        </div>

        <div class="alert alert-err" id="s1Err" hidden role="alert" style="margin-top:20px">
          <svg class="ic" aria-hidden="true"><use href="#i-alert"/></svg>
          <div class="body"><b>Not saved</b><p id="s1ErrMsg"></p></div>
        </div>

        <div class="acts">
          <button class="btn btn-p" type="submit" id="btnContinue">
            <span class="spin" id="c1Spin" hidden></span>
            <span id="c1Label">Continue</span>
            <svg class="ic" id="c1Arrow" aria-hidden="true"><use href="#i-arrow"/></svg>
          </button>
          <span class="hint" id="c1Note" hidden>Saving to the server</span>
        </div>
      </form>
    </div>

    <!-- step 2 -->
    <div id="p2" hidden>
      <h1>Import existing work</h1>
      <p class="lede">Upload a CSV of tasks, or skip and start empty.</p>

      <div class="sec" id="dropSec">
        <div class="drop" id="drop">
          <svg class="art" viewBox="0 0 120 70" aria-hidden="true">
            <rect x="24" y="14" width="72" height="48" rx="7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-dasharray="7 6" opacity=".55"/>
            <path d="M60 50V26M50 34l10-10 10 10" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <b>Drop a CSV here</b>
          <span class="hint">Columns: name, owner, due, status</span>
          <div class="row">
            <button class="btn btn-p" type="button" id="btnChoose">Choose file</button>
            <button class="btn btn-s" type="button" id="btnSample">Use sample</button>
          </div>
          <input type="file" id="fileInput" accept=".csv,text/csv" class="sr">
        </div>
      </div>

      <div class="sec stack" id="impSec" hidden>
        <div class="card">
          <div class="filerow">
            <span class="fico"><svg class="ic" aria-hidden="true"><use href="#i-file"/></svg></span>
            <span class="fmeta"><b id="fName">file.csv</b><span id="fSize">0 KB</span></span>
            <span class="chip c-q" id="jChip" aria-live="polite"><span class="dot"></span><span id="jChipTxt">Queued</span></span>
          </div>

          <div style="margin-top:14px">
            <div class="barrow"><span id="barLabel">Uploading</span><span class="pct" id="barPct">0%</span></div>
            <div class="bar" id="bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Import progress"><i id="barFill"></i></div>
            <p class="hint" id="jMeta" style="margin-top:7px"></p>
          </div>

          <div class="acts" style="margin-top:14px">
            <button class="btn btn-s" type="button" id="btnCancelImp"><svg class="ic" aria-hidden="true"><use href="#i-x"/></svg><span id="cancelLbl">Cancel upload</span></button>
            <button class="btn btn-s" type="button" id="btnRetryJob" hidden><svg class="ic" aria-hidden="true"><use href="#i-redo"/></svg><span id="retryLbl">Retry</span></button>
            <a class="btn btn-s" id="dlLink" hidden download><svg class="ic" aria-hidden="true"><use href="#i-dl"/></svg>Download result</a>
            <button class="btn btn-g" type="button" id="btnAnother" hidden>Another file</button>
          </div>
        </div>

        <div class="alert alert-err" id="impErr" hidden role="alert">
          <svg class="ic" aria-hidden="true"><use href="#i-alert"/></svg>
          <div class="body"><b id="impErrTitle">Import failed</b><p id="impErrMsg"></p></div>
        </div>

        <div class="alert alert-ok" id="impOk" hidden>
          <svg class="ic" aria-hidden="true"><use href="#i-check"/></svg>
          <div class="body"><b>Import finished</b><p id="impOkMsg"></p></div>
        </div>

        <div class="alert alert-i" id="impStale" hidden>
          <svg class="ic" aria-hidden="true"><use href="#i-alert"/></svg>
          <div class="body"><p id="impStaleMsg"></p></div>
        </div>
      </div>

      <div class="acts">
        <button class="btn btn-p" type="button" id="btnGo3" hidden>Continue<svg class="ic" aria-hidden="true"><use href="#i-arrow"/></svg></button>
        <button class="btn btn-g" type="button" id="btnSkipImp">Skip import</button>
      </div>
    </div>

    <!-- step 3 -->
    <div id="p3" hidden>
      <h1>Review and open</h1>
      <p class="lede">The workspace is created on the server when you open it.</p>

      <div class="sec">
        <ul class="sum">
          <li><span class="tick"><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg></span><span class="k">Workspace</span><span class="v" id="sumWs">--</span></li>
          <li><span class="tick"><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg></span><span class="k">Default view</span><span class="v" id="sumView">--</span></li>
          <li><span class="tick" id="sumImpTick"><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg></span><span class="k">Import</span><span class="v" id="sumImp">--</span></li>
        </ul>
      </div>

      <div class="alert alert-err" id="finErr" hidden role="alert" style="margin-top:18px">
        <svg class="ic" aria-hidden="true"><use href="#i-alert"/></svg>
        <div class="body"><b>Could not open workspace</b><p id="finErrMsg"></p></div>
      </div>

      <div class="acts">
        <button class="btn btn-p" type="button" id="btnFinish">
          <span class="spin" id="finSpin" hidden></span><span id="finLabel">Open workspace</span>
        </button>
        <span class="hint" id="finNote" hidden>Saving to the server</span>
      </div>
    </div>

    <!-- workspace -->
    <div id="pw" hidden>
      <div class="wshead">
        <span class="av" id="wsAv">--</span>
        <div>
          <h1 id="wsTitle">Workspace</h1>
          <p class="lede" id="wsSub">0 projects</p>
        </div>
        <span class="plan" id="wsPlan" hidden></span>
      </div>

      <div class="alert alert-err" id="wsAlert" hidden role="alert" style="margin-bottom:16px">
        <svg class="ic" aria-hidden="true"><use href="#i-alert"/></svg>
        <div class="body"><b>Could not refresh</b><p id="wsAlertMsg"></p></div>
      </div>

      <div class="grid" id="projGrid" hidden></div>

      <div class="empty" id="empty">
        <svg class="art" viewBox="0 0 240 132" aria-hidden="true">
          <rect x="8" y="16" width="66" height="104" rx="9" fill="none" stroke="var(--line)" stroke-width="2.4"/>
          <rect x="87" y="16" width="66" height="104" rx="9" fill="none" stroke="var(--line)" stroke-width="2.4"/>
          <rect x="166" y="16" width="66" height="104" rx="9" fill="none" stroke="var(--line)" stroke-width="2.4"/>
          <rect x="20" y="30" width="34" height="6" rx="3" fill="var(--track)"/>
          <rect x="99" y="30" width="30" height="6" rx="3" fill="var(--track)"/>
          <rect x="178" y="30" width="38" height="6" rx="3" fill="var(--track)"/>
          <rect x="20" y="48" width="42" height="26" rx="6" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-dasharray="6 5"/>
          <path d="M41 55v13M34.5 61.5h13" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round"/>
        </svg>
        <h2>No projects yet</h2>
        <p class="sub">The server lists nothing in this workspace. Import a CSV to bring existing work in.</p>
        <div class="row">
          <button class="btn btn-p" type="button" id="btnEmptyImport">Import CSV</button>
          <button class="btn btn-s" type="button" id="btnRefresh"><span class="spin" id="refSpin" hidden></span><svg class="ic" id="refIc" aria-hidden="true"><use href="#i-redo"/></svg><span id="refLbl">Refresh</span></button>
        </div>
        <div class="alert alert-i" id="emptyNote" hidden style="margin-top:18px;text-align:left">
          <svg class="ic" aria-hidden="true"><use href="#i-alert"/></svg>
          <div class="body"><p id="emptyNoteMsg"></p></div>
        </div>
      </div>
    </div>

  </section>
</div>

<dialog id="dlg" aria-labelledby="dlgH">
  <h2 id="dlgH">Cancel the import?</h2>
  <p class="sub" id="dlgP">The file stays on your machine. You can import it again later.</p>
  <div class="alert alert-err" id="dlgErr" hidden role="alert" style="margin-top:14px">
    <svg class="ic" aria-hidden="true"><use href="#i-alert"/></svg>
    <div class="body"><p id="dlgErrMsg"></p></div>
  </div>
  <div class="dacts">
    <button class="btn btn-s" type="button" id="dlgNo">Keep importing</button>
    <button class="btn btn-d" type="button" id="dlgYes"><span class="spin" id="dlgSpin" hidden></span><span id="dlgYesLbl">Cancel import</span></button>
  </div>
</dialog>

<script>
(function () {
  "use strict";
  var api = window.api;
  var $ = function (id) { return document.getElementById(id); };

  function txt(el, s) { if (el.textContent !== s) el.textContent = s; }
  function show(el, on) { if (el.hidden === on) el.hidden = !on; }
  function dis(el, on) { if (el.disabled !== on) el.disabled = on; }
  function cls(el, name, on) { el.classList.toggle(name, !!on); }

  var S = {
    view: "setup",
    step: 1,
    user: null, userErr: null, userLoading: true,
    wsName: "My workspace", wsTouched: false, viewStyle: "board",
    nameErr: null,
    s1Pending: false, s1Err: null, s1Done: false,
    file: null, fileId: null,
    phase: "pick",
    pct: 0, impErr: null, pollErr: null,
    job: null, jobStart: 0, cancelPending: false, retryPending: false,
    importOutcome: "none",
    finPending: false, finErr: null,
    projects: null, refreshing: false, refreshErr: null
  };

  var upCtl = null, procCtl = null, pollTimer = null, ticking = false;
  var STYLE_LABEL = { board: "Board", list: "List", timeline: "Timeline" };
  var RING_C = 163.4;

  function errText(e, what) {
    if (e && e.name === "AbortError") return "Cancelled.";
    if (e && e.code === "NETWORK") return "The server did not respond while " + what + ". Nothing was changed.";
    if (e && e.code === "NOT_FOUND") return "The server no longer has a record of this import.";
    if (e && e.message) return e.message;
    return "Unexpected error while " + what + ".";
  }
  function bytes(n) {
    if (n < 1024) return n + " B";
    if (n < 1048576) return (n / 1024).toFixed(1) + " KB";
    return (n / 1048576).toFixed(1) + " MB";
  }
  function initials(name) {
    var p = String(name || "").trim().split(/\s+/).filter(Boolean);
    if (!p.length) return "--";
    return (p[0][0] + (p.length > 1 ? p[p.length - 1][0] : "")).toUpperCase();
  }
  function num(n) { return Number(n).toLocaleString(); }
  function importing() { return S.phase === "uploading" || S.phase === "starting" || S.phase === "processing"; }

  /* ---------------- render ---------------- */

  function renderRail() {
    var done = [S.s1Done, S.importOutcome !== "none", S.view === "workspace"];
    var n = (done[0] ? 1 : 0) + (done[1] ? 1 : 0) + (done[2] ? 1 : 0);
    $("ringArc").setAttribute("stroke-dashoffset", String(RING_C * (1 - n / 3)));
    txt($("ringNum"), S.view === "workspace" ? "Setup complete" : "Step " + S.step + " of 3");

    for (var i = 1; i <= 3; i++) {
      var li = $("li" + i), bead = $("bead" + i), active = S.step === i && S.view === "setup";
      var isDone = done[i - 1] && !active;
      cls(li, "done", isDone);
      cls(li, "active", active);
      if (isDone) {
        if (bead.getAttribute("data-c") !== "1") { bead.setAttribute("data-c", "1"); bead.innerHTML = '<svg class="ic" aria-hidden="true"><use href="#i-check"/></svg>'; }
      } else if (bead.getAttribute("data-c") !== "0") {
        bead.setAttribute("data-c", "0"); bead.textContent = String(i);
      }
      var nav = li.firstElementChild;
      dis(nav, i > 1 && !S.s1Done);
      nav.setAttribute("aria-current", active ? "step" : "false");
    }

    var busy = importing();
    show($("railJob"), busy && S.step !== 2 && S.view === "setup");
    if (busy) {
      var p = S.phase === "uploading" ? S.pct : (S.job ? S.job.progress : 0);
      txt($("rjLabel"), S.phase === "uploading" ? "Uploading" :
        S.phase === "starting" ? "Starting" :
        (S.job && S.job.status === "queued" ? "Queued" : "Processing"));
      txt($("rjPct"), p + "%");
      $("rjFill").style.width = p + "%";
      $("rjBar").setAttribute("aria-valuenow", String(p));
    }
  }

  function renderUser() {
    var u = S.user;
    show($("whoSk"), S.userLoading);
    show($("whoAvSk"), S.userLoading);
    show($("whoReal"), !S.userLoading && !!u);
    show($("whoAv"), !S.userLoading && !!u);
    show($("whoPlan"), !S.userLoading && !!u);
    show($("whoErr"), !!S.userErr);
    $("who").setAttribute("aria-busy", S.userLoading ? "true" : "false");
    if (S.userErr) txt($("whoErrMsg"), S.userErr);
    if (u) {
      txt($("whoAv"), initials(u.name));
      txt($("whoName"), u.name);
      txt($("whoMail"), u.email);
      txt($("whoPlan"), u.plan);
    }
  }

  function renderStep1() {
    show($("wsErr"), !!S.nameErr);
    if (S.nameErr) txt($("wsErrMsg"), S.nameErr);
    $("wsName").setAttribute("aria-invalid", S.nameErr ? "true" : "false");
    show($("s1Err"), !!S.s1Err);
    if (S.s1Err) txt($("s1ErrMsg"), S.s1Err);
    dis($("btnContinue"), S.s1Pending);
    show($("c1Spin"), S.s1Pending);
    show($("c1Arrow"), !S.s1Pending);
    show($("c1Note"), S.s1Pending);
    txt($("c1Label"), S.s1Pending ? "Saving" : (S.s1Err ? "Try again" : "Continue"));
    var seg = $("seg").children;
    for (var i = 0; i < seg.length; i++) {
      seg[i].setAttribute("aria-checked", seg[i].dataset.style === S.viewStyle ? "true" : "false");
    }
  }

  function renderStep2() {
    var ph = S.phase, active = importing();
    show($("dropSec"), ph === "pick");
    show($("impSec"), ph !== "pick");
    show($("btnGo3"), ph !== "pick" && !active);

    if (S.file) { txt($("fName"), S.file.name); txt($("fSize"), bytes(S.file.size)); }

    var chipTxt = "Queued", chipCls = "c-q", pct = 0, label = "Uploading", indet = false, barCls = "";
    if (ph === "uploading") { chipTxt = "Uploading"; chipCls = "c-run"; pct = S.pct; }
    else if (ph === "starting") { chipTxt = "Starting"; chipCls = "c-run"; indet = true; label = "Handing the file to the server"; }
    else if (ph === "processing") {
      var st = S.job ? S.job.status : "queued";
      chipTxt = st === "queued" ? "Queued" : "Processing";
      chipCls = st === "queued" ? "c-q" : "c-run";
      indet = st === "queued";
      pct = S.job ? S.job.progress : 0;
      label = st === "queued" ? "Waiting for a worker" : "Processing rows";
    }
    else if (ph === "done") { chipTxt = "Imported"; chipCls = "c-ok"; pct = 100; label = "Finished"; barCls = "ok"; }
    else if (ph === "failed") {
      var cancelled = S.job && S.job.error === "Cancelled by admin";
      chipTxt = cancelled ? "Cancelled" : "Failed"; chipCls = "c-bad";
      pct = S.job ? S.job.progress : 0; label = "Stopped"; barCls = "bad";
    }
    else if (ph === "cancelled") { chipTxt = "Cancelled"; chipCls = "c-bad"; pct = S.pct; label = "Stopped"; barCls = "bad"; }
    else if (ph === "error") { chipTxt = "Not started"; chipCls = "c-bad"; pct = S.pct; label = "Stopped"; barCls = "bad"; }

    var chip = $("jChip"), cn = "chip " + chipCls;
    if (chip.className !== cn) chip.className = cn;
    txt($("jChipTxt"), chipTxt);
    txt($("barLabel"), label);
    txt($("barPct"), indet ? "--" : pct + "%");
    var bar = $("bar"), bn = "bar" + (barCls ? " " + barCls : "") + (indet ? " indet" : "");
    if (bar.className !== bn) bar.className = bn;
    $("barFill").style.width = indet ? "" : pct + "%";
    bar.setAttribute("aria-valuenow", String(pct));

    var meta = "";
    if (ph === "uploading") meta = "Cancel is available until the upload finishes.";
    else if (ph === "processing" && S.jobStart) meta = "Running for " + Math.max(0, Math.round((Date.now() - S.jobStart) / 1000)) + "s  ·  " + S.job.id;
    else if (ph === "done" && S.job && S.job.result) meta = num(S.job.result.rows) + " rows  ·  " + S.job.id;
    else if (S.job && S.job.id) meta = S.job.id;
    if (S.pollErr) meta = S.pollErr;
    txt($("jMeta"), meta);

    show($("btnCancelImp"), active);
    dis($("btnCancelImp"), S.cancelPending);
    txt($("cancelLbl"), S.cancelPending ? "Cancelling" : (ph === "processing" ? "Cancel import" : "Cancel upload"));
    show($("btnRetryJob"), ph === "failed" || ph === "error" || ph === "cancelled");
    dis($("btnRetryJob"), S.retryPending);
    txt($("retryLbl"), S.retryPending ? "Retrying" : "Retry");
    show($("btnAnother"), !active && ph !== "pick");

    var dl = $("dlLink"), hasDl = ph === "done" && !!(S.job && S.job.result && S.job.result.downloadUrl);
    show(dl, hasDl);
    if (hasDl && dl.getAttribute("href") !== S.job.result.downloadUrl) dl.href = S.job.result.downloadUrl;

    var errOn = (ph === "failed" && S.job && S.job.error) || (ph === "error" && S.impErr) || ph === "cancelled";
    show($("impErr"), !!errOn);
    if (errOn) {
      if (ph === "failed") {
        var wasCancel = S.job.error === "Cancelled by admin";
        txt($("impErrTitle"), wasCancel ? "Import cancelled" : "The server could not process this file");
        txt($("impErrMsg"), S.job.error);
      } else if (ph === "cancelled") {
        txt($("impErrTitle"), "Upload cancelled");
        txt($("impErrMsg"), "Nothing was sent. Retry, pick another file, or skip this step.");
      } else {
        txt($("impErrTitle"), "Import did not start");
        txt($("impErrMsg"), S.impErr);
      }
    }
    show($("impOk"), ph === "done");
    if (ph === "done" && S.job && S.job.result) txt($("impOkMsg"), num(S.job.result.rows) + " rows read from " + S.file.name + ".");
    var stale = ph === "done" && Array.isArray(S.projects) && S.projects.length === 0;
    show($("impStale"), stale);
    if (stale) txt($("impStaleMsg"), "The server still lists no projects in this workspace.");
  }

  function renderStep3() {
    txt($("sumWs"), S.wsName);
    txt($("sumView"), STYLE_LABEL[S.viewStyle]);
    var t = $("sumImpTick");
    if (S.importOutcome === "done" && S.job && S.job.result) { txt($("sumImp"), num(S.job.result.rows) + " rows imported"); cls(t, "skip", false); }
    else if (S.importOutcome === "failed") { txt($("sumImp"), "Failed, nothing imported"); cls(t, "skip", true); }
    else if (S.importOutcome === "cancelled") { txt($("sumImp"), "Cancelled, nothing imported"); cls(t, "skip", true); }
    else { txt($("sumImp"), "Skipped"); cls(t, "skip", true); }
    show($("finErr"), !!S.finErr);
    if (S.finErr) txt($("finErrMsg"), S.finErr);
    dis($("btnFinish"), S.finPending);
    show($("finSpin"), S.finPending);
    show($("finNote"), S.finPending);
    txt($("finLabel"), S.finPending ? "Opening" : (S.finErr ? "Try again" : "Open workspace"));
  }

  function renderWorkspace() {
    var ps = S.projects || [];
    txt($("wsTitle"), S.wsName);
    txt($("wsAv"), initials(S.user && S.user.name));
    txt($("wsSub"), (ps.length === 1 ? "1 project" : ps.length + " projects") + "  ·  " + STYLE_LABEL[S.viewStyle] + " view");
    show($("wsPlan"), !!S.user);
    if (S.user) txt($("wsPlan"), S.user.plan);

    show($("wsAlert"), !!S.refreshErr);
    if (S.refreshErr) txt($("wsAlertMsg"), S.refreshErr);

    show($("empty"), ps.length === 0);
    show($("projGrid"), ps.length > 0);
    if (ps.length > 0) {
      var g = $("projGrid"), key = ps.map(function (p) { return p.id; }).join(",");
      if (g.getAttribute("data-k") !== key) {
        g.setAttribute("data-k", key);
        g.textContent = "";
        for (var i = 0; i < ps.length; i++) {
          var c = document.createElement("div"); c.className = "pcard";
          var sw = document.createElement("div"); sw.className = "swatch";
          var b = document.createElement("b"); b.textContent = ps[i].name;
          var s = document.createElement("span");
          var d = new Date(ps[i].createdAt);
          s.textContent = "Created " + (isNaN(d.getTime()) ? String(ps[i].createdAt) : d.toLocaleDateString());
          c.appendChild(sw); c.appendChild(b); c.appendChild(s);
          g.appendChild(c);
        }
      }
    }
    var note = S.importOutcome === "done" && ps.length === 0 && S.job && S.job.result;
    show($("emptyNote"), !!note);
    if (note) txt($("emptyNoteMsg"), "Your import finished with " + num(S.job.result.rows) + " rows. The server still lists no projects here.");
    show($("refSpin"), S.refreshing);
    show($("refIc"), !S.refreshing);
    dis($("btnRefresh"), S.refreshing);
    txt($("refLbl"), S.refreshing ? "Refreshing" : "Refresh");
  }

  function render() {
    var ws = S.view === "workspace";
    show($("rail"), !ws);
    show($("p1"), !ws && S.step === 1);
    show($("p2"), !ws && S.step === 2);
    show($("p3"), !ws && S.step === 3);
    show($("pw"), ws);
    show($("doneBanner"), !ws && !!(S.user && S.user.hasCompletedOnboarding));
    renderRail();
    if (ws) { renderWorkspace(); return; }
    renderUser();
    if (S.step === 1) renderStep1();
    else if (S.step === 2) renderStep2();
    else renderStep3();
  }

  /* ---------------- account ---------------- */

  function loadUser() {
    S.userLoading = true; S.userErr = null; render();
    api.getUser().then(function (u) {
      S.user = u;
      S.userLoading = false;
      S.projects = Array.isArray(u.projects) ? u.projects.slice() : [];
      if (!S.wsTouched) {
        var first = String(u.name || "").trim().split(/\s+/)[0];
        if (first) { S.wsName = first + "'s workspace"; $("wsName").value = S.wsName; }
      }
      render();
    }).catch(function (e) {
      S.userLoading = false;
      S.userErr = errText(e, "loading your account");
      render();
    });
  }

  /* ---------------- step 1 ---------------- */

  $("wsName").addEventListener("input", function (e) {
    S.wsTouched = true;
    S.wsName = e.target.value;
    if (S.nameErr) { S.nameErr = null; renderStep1(); }
  });

  $("seg").addEventListener("click", function (e) {
    var b = e.target.closest("button[data-style]");
    if (!b) return;
    S.viewStyle = b.dataset.style;
    renderStep1();
  });

  $("seg").addEventListener("keydown", function (e) {
    var order = ["board", "list", "timeline"], i = order.indexOf(S.viewStyle);
    if (e.key === "ArrowRight" || e.key === "ArrowDown") { S.viewStyle = order[(i + 1) % 3]; }
    else if (e.key === "ArrowLeft" || e.key === "ArrowUp") { S.viewStyle = order[(i + 2) % 3]; }
    else return;
    e.preventDefault();
    renderStep1();
    $("seg").querySelector('[data-style="' + S.viewStyle + '"]').focus();
  });

  $("btnWhoRetry").addEventListener("click", loadUser);
  $("btnSkipToWs").addEventListener("click", function () { S.view = "workspace"; render(); });

  $("f1").addEventListener("submit", function (e) {
    e.preventDefault();
    if (S.s1Pending) return;
    var name = $("wsName").value.trim();
    if (name.length < 2) {
      S.nameErr = "Enter a name with at least 2 characters.";
      renderStep1();
      $("wsName").focus();
      return;
    }
    S.wsName = name; S.nameErr = null; S.s1Err = null; S.s1Pending = true;
    renderStep1();
    api.updateSettings({ workspaceName: name, defaultView: S.viewStyle }).then(function () {
      S.s1Pending = false;
      S.s1Done = true;
      S.step = 2;
      render();
    }).catch(function (err) {
      S.s1Pending = false;
      S.s1Err = errText(err, "saving the workspace");
      renderStep1();
      renderRail();
    });
  });

  $("steps").addEventListener("click", function (e) {
    var b = e.target.closest("button[data-go]");
    if (!b || b.disabled || S.view === "workspace") return;
    S.step = Number(b.dataset.go);
    render();
  });

  /* ---------------- step 2: import ---------------- */

  function stopPoll() { if (pollTimer) { clearInterval(pollTimer); pollTimer = null; } }
  function startPoll() { stopPoll(); pollTimer = setInterval(tick, 700); }

  function resetImport() {
    stopPoll();
    upCtl = null; procCtl = null;
    S.file = null; S.fileId = null; S.phase = "pick"; S.pct = 0;
    S.impErr = null; S.pollErr = null; S.job = null; S.jobStart = 0;
    S.cancelPending = false; S.retryPending = false; S.importOutcome = "none";
    $("fileInput").value = "";
  }

  function paintImport() {
    if (S.view === "setup" && S.step === 2) renderStep2();
    renderRail();
  }

  function tick() {
    if (!S.job || !S.job.id || ticking) return;
    ticking = true;
    api.getJob(S.job.id).then(function (j) {
      S.pollErr = null;
      S.job = j;
      if (j.status === "succeeded" || j.status === "failed") {
        stopPoll();
        S.phase = j.status === "succeeded" ? "done" : "failed";
        S.importOutcome = j.status === "succeeded" ? "done" : (j.error === "Cancelled by admin" ? "cancelled" : "failed");
        refreshProjects();
      } else {
        S.phase = "processing";
      }
    }).catch(function (e) {
      S.pollErr = (e && e.code === "NOT_FOUND")
        ? "The server no longer has a record of this import."
        : "Lost contact with the server, still retrying.";
    }).then(function () {
      ticking = false;
      paintImport();
    });
  }

  function startJob(fileId) {
    S.phase = "starting"; S.impErr = null; S.pollErr = null;
    procCtl = new AbortController();
    render();
    return api.processFile(fileId, { signal: procCtl.signal }).then(function (r) {
      S.job = { id: r.jobId, status: "queued", progress: 0 };
      S.jobStart = Date.now();
      S.phase = "processing";
      S.importOutcome = "none";
      startPoll();
      render();
    }).catch(function (e) {
      if (e && e.name === "AbortError") { S.phase = "cancelled"; S.importOutcome = "cancelled"; }
      else { S.phase = "error"; S.impErr = errText(e, "starting the import"); S.importOutcome = "failed"; }
      render();
    });
  }

  function startImport(file) {
    if (importing()) return;
    S.file = { name: file.name, size: file.size };
    S.phase = "uploading"; S.pct = 0;
    S.impErr = null; S.pollErr = null; S.job = null; S.jobStart = 0;
    S.importOutcome = "none";
    upCtl = new AbortController();
    render();
    api.uploadFile(file, {
      signal: upCtl.signal,
      onProgress: function (p) {
        var v = Math.round(p);
        S.pct = v < 0 ? 0 : v > 100 ? 100 : v;
        paintImport();
      }
    }).then(function (res) {
      S.fileId = res.fileId;
      return startJob(res.fileId);
    }).catch(function (e) {
      if (e && e.name === "AbortError") { S.phase = "cancelled"; S.importOutcome = "cancelled"; }
      else { S.phase = "error"; S.impErr = errText(e, "uploading the file"); S.importOutcome = "failed"; }
      render();
    });
  }

  function sampleFile() {
    var rows = [
      "name,owner,due,status",
      "Onboarding revamp,Alex,2026-10-02,active",
      "Q4 roadmap,Priya,2026-10-14,planned",
      "Billing migration,Sam,2026-09-30,active",
      "Docs cleanup,Nina,2026-11-01,planned",
      "Mobile beta,Alex,2026-10-21,blocked",
      "Retention audit,Sam,2026-12-04,planned"
    ].join("\n");
    return new File([rows], "sample-projects.csv", { type: "text/csv" });
  }

  $("btnChoose").addEventListener("click", function () { $("fileInput").click(); });
  $("btnSample").addEventListener("click", function () { startImport(sampleFile()); });
  $("fileInput").addEventListener("change", function (e) {
    var f = e.target.files && e.target.files[0];
    if (f) startImport(f);
  });

  var drop = $("drop");
  ["dragenter", "dragover"].forEach(function (n) {
    drop.addEventListener(n, function (e) { e.preventDefault(); cls(drop, "over", true); });
  });
  ["dragleave", "drop"].forEach(function (n) {
    drop.addEventListener(n, function (e) { e.preventDefault(); cls(drop, "over", false); });
  });
  drop.addEventListener("drop", function (e) {
    var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
    if (f) startImport(f);
  });

  $("btnAnother").addEventListener("click", function () { resetImport(); render(); });

  $("btnRetryJob").addEventListener("click", function () {
    if (S.retryPending) return;
    if (S.phase === "failed" && S.job && S.job.id) {
      S.retryPending = true;
      renderStep2();
      api.retryJob(S.job.id).then(function (j) {
        S.retryPending = false;
        S.job = j;
        S.jobStart = Date.now();
        S.phase = "processing";
        S.importOutcome = "none";
        S.pollErr = null;
        startPoll();
        render();
      }).catch(function (e) {
        S.retryPending = false;
        S.phase = "error";
        S.impErr = errText(e, "restarting the import");
        render();
      });
    } else if (S.fileId) {
      startJob(S.fileId);
    } else {
      resetImport();
      render();
    }
  });

  function cancelImport() {
    if (S.phase === "uploading") { if (upCtl) upCtl.abort(); return Promise.resolve(); }
    if (S.phase === "starting") { if (procCtl) procCtl.abort(); return Promise.resolve(); }
    if (S.phase === "processing" && S.job && S.job.id) {
      S.cancelPending = true;
      paintImport();
      return api.cancelJob(S.job.id).then(function (j) {
        S.cancelPending = false;
        S.job = j;
        if (j.status === "failed" || j.status === "succeeded") {
          stopPoll();
          S.phase = j.status === "failed" ? "failed" : "done";
          S.importOutcome = j.status === "failed" ? "cancelled" : "done";
          refreshProjects();
        }
        render();
      }).catch(function (e) {
        S.cancelPending = false;
        S.pollErr = errText(e, "cancelling the import");
        render();
        throw e;
      });
    }
    return Promise.resolve();
  }

  $("btnCancelImp").addEventListener("click", function () {
    cancelImport().catch(function () {});
  });

  $("btnGo3").addEventListener("click", function () {
    if (S.importOutcome === "none") S.importOutcome = "skipped";
    S.step = 3;
    render();
  });

  var dlg = $("dlg");
  $("btnSkipImp").addEventListener("click", function () {
    if (importing() && typeof dlg.showModal === "function") {
      show($("dlgErr"), false);
      dlg.showModal();
      return;
    }
    if (S.importOutcome === "none") S.importOutcome = "skipped";
    S.step = 3;
    render();
  });
  $("dlgNo").addEventListener("click", function () { dlg.close(); });
  dlg.addEventListener("cancel", function (e) { e.preventDefault(); dlg.close(); });
  $("dlgYes").addEventListener("click", function () {
    if ($("dlgYes").disabled) return;
    show($("dlgSpin"), true);
    dis($("dlgYes"), true);
    txt($("dlgYesLbl"), "Cancelling");
    cancelImport().then(function () {
      show($("dlgSpin"), false);
      dis($("dlgYes"), false);
      txt($("dlgYesLbl"), "Cancel import");
      dlg.close();
      if (S.importOutcome === "none") S.importOutcome = "cancelled";
      S.step = 3;
      render();
    }, function (e) {
      show($("dlgSpin"), false);
      dis($("dlgYes"), false);
      txt($("dlgYesLbl"), "Cancel import");
      txt($("dlgErrMsg"), errText(e, "cancelling the import") + " The import is still running.");
      show($("dlgErr"), true);
    });
  });

  /* ---------------- step 3 ---------------- */

  $("btnFinish").addEventListener("click", function () {
    if (S.finPending) return;
    S.finPending = true;
    S.finErr = null;
    renderStep3();
    api.updateSettings({
      workspaceName: S.wsName,
      defaultView: S.viewStyle,
      hasCompletedOnboarding: true
    }).then(function () {
      return api.getUser().then(function (u) { return u; }, function () { return null; });
    }).then(function (u) {
      if (u) {
        S.user = u;
        S.projects = Array.isArray(u.projects) ? u.projects.slice() : [];
      }
      S.finPending = false;
      S.view = "workspace";
      render();
    }).catch(function (e) {
      S.finPending = false;
      S.finErr = errText(e, "finishing setup");
      renderStep3();
    });
  });

  /* ---------------- workspace ---------------- */

  function refreshProjects() {
    return api.getUser().then(function (u) {
      S.refreshErr = null;
      S.user = u;
      S.projects = Array.isArray(u.projects) ? u.projects.slice() : [];
      render();
    }, function (e) {
      S.refreshErr = errText(e, "reading your projects");
      render();
    });
  }

  $("btnRefresh").addEventListener("click", function () {
    if (S.refreshing) return;
    S.refreshing = true;
    renderWorkspace();
    refreshProjects().then(function () {
      S.refreshing = false;
      renderWorkspace();
    });
  });

  $("btnEmptyImport").addEventListener("click", function () {
    if (!importing()) resetImport();
    S.view = "setup";
    S.step = 2;
    render();
  });

  render();
  loadUser();
})();
</script>
</body>
</html>
